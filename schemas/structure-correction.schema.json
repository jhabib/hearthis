{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hearthis.structure-correction/v1",
  "title": "Hear This structure correction",
  "type": "object",
  "required": ["schema", "annotator", "created_at", "sections"],
  "properties": {
    "schema": {"const": "hearthis.structure-correction/v1"},
    "base_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotator": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "annotation_source": {"enum": ["human", "llm"], "default": "human"},
    "provenance": {
      "type": "object",
      "required": ["model", "method", "audio_listened", "independent_reference", "evidence_path", "evidence_sha256"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "audio_listened": {"type": "boolean"},
        "independent_reference": {"type": "boolean"},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [{
        "if": {"properties": {"independent_reference": {"const": true}}},
        "then": {"properties": {"audio_listened": {"const": true}}}
      }],
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_seconds", "end_seconds", "label"],
        "properties": {
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "exclusiveMinimum": 0},
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"annotation_source": {"const": "llm"}}, "required": ["annotation_source"]},
      "then": {"required": ["provenance", "base_manifest_sha256"]}
    }
  ],
  "additionalProperties": false
}
